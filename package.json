{
  "name": "personal-website",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "prebuild": "npm run images:check && npm run gallery:check",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "node --test --experimental-strip-types $(find lib -name '*.test.ts' -type f)",
    "images:add": "node scripts/content-images.mjs add",
    "images:check": "node scripts/content-images.mjs check",
    "gallery:add": "node scripts/gallery-image.mjs add",
    "gallery:check": "node scripts/gallery-image.mjs check",
    "knowledge:doctor": "node scripts/knowledge-field.mjs doctor",
    "knowledge:sync": "node scripts/knowledge-field.mjs sync-obsidian",
    "knowledge:sync:apply": "node scripts/knowledge-field.mjs sync-obsidian --apply",
    "knowledge:draft-blog": "node scripts/knowledge-field.mjs draft-blog",
    "knowledge:confirm-publish": "node scripts/knowledge-field.mjs confirm-publish",
    "knowledge:deploy-production": "node scripts/knowledge-field.mjs deploy-production",
    "knowledge:report": "node scripts/knowledge-field.mjs report",
    "knowledge:cron": "bash scripts/knowledge-field-cron.sh"
  },
  "dependencies": {
    "@next/mdx": "16.2.7",
    "@vercel/analytics": "^2.0.1",
    "@vercel/og": "^0.11.1",
    "framer-motion": "^12.40.0",
    "github-slugger": "^2.0.0",
    "gray-matter": "^4.0.3",
    "mermaid": "^11.15.0",
    "next": "16.2.7",
    "next-mdx-remote": "^6.0.0",
    "next-themes": "^0.4.6",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "react-modern-audio-player": "^2.4.1",
    "rehype-autolink-headings": "^7.1.0",
    "rehype-pretty-code": "^0.14.3",
    "rehype-slug": "^6.0.0",
    "remark-gfm": "^4.0.1",
    "shiki": "^4.2.0",
    "zod": "^4.1.13"
  },
  "devDependencies": {
    "@types/node": "^24.10.1",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "eslint": "^9.39.1",
    "eslint-config-next": "16.2.7",
    "typescript": "^5.9.3"
  }
}
